#include <oboe/Oboe.h>

class AudifonoPropietarioEngine : public oboe::AudioStreamDataCallback {
public:
    void iniciarAudio() {
        oboe::AudioStreamBuilder builder;
        builder.setDirection(oboe::Direction::InputAndOutput) // Captura y reproduce
               .setPerformanceMode(oboe::PerformanceMode::LowLatency) // Latencia ultra baja
               .setSharingMode(oboe::SharingMode::Exclusive) // Uso exclusivo del chip de audio
               .setFormat(oboe::AudioFormat::Float)
               .setChannelCount(oboe::ChannelCount::Mono)
               .setDataCallback(this)
               .openStream(stream);
               
        stream->requestStart();
    }

    oboe::DataCallbackResult onAudioReady(
        oboe::AudioStream *audioStream, void *audioData, int32_t numFrames) override {
        
        float *floatData = static_cast<float *>(audioData);
        
        for (int i = 0; i < numFrames; ++i) {
            // ALGORITMO DE AMPLIFICACIÓN PERSONALIZADA
            // Aquí multiplicamos la señal por el factor de ganancia elegido por el usuario
            floatData[i] *= factorGanancia; 
            
            // Filtro básico para evitar distorsión (Limpiador)
            if (floatData[i] > 1.0f) floatData[i] = 1.0f;
            if (floatData[i] < -1.0f) floatData[i] = -1.0f;
        }
        return oboe::DataCallbackResult::Continue;
    }

private:
    oboe::ManagedStream stream;
    float factorGanancia = 2.5f; // Nivel de amplificación inicial
};